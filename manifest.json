{
  "manifest_version": 3,
  "name": "Mazevo Setup Planner",
  "version": "1.0.0",
  "description": "Compares today's room setups with tomorrow's in Mazevo Manage Operations and lists what each room needs to change into.",
  "action": {
    "default_title": "Plan tomorrow's room setups",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://*.mymazevo.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.mymazevo.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.mymazevo.com/*"],
      "js": ["planner.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
